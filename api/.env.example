# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_PUBLIC_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_AGENT=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Voyage AI — must match recipe_embeddings VECTOR(1024). voyage-3-lite is 512-dim
# and will fail inserts; voyage-3 is native 1024.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_EMBEDDING_DIM=1024

# Field encryption
FIELD_ENCRYPTION_KEY=

# Stripe
STRIPE_WEBHOOK_SECRET=

# Database
# Inside Docker Compose network: postgresql+asyncpg://nouri:nouri@db:5432/nouri
# Host tools (seed/pytest/alembic): db/session.py rewrites @db → @localhost automatically
# Or set explicitly: postgresql+asyncpg://nouri:nouri@localhost:5432/nouri
DATABASE_URL=
# Optional explicit override for pytest only
# TEST_DATABASE_URL=postgresql+asyncpg://nouri:nouri@localhost:5432/nouri

# App
ENVIRONMENT=production
# Include localhost origins for local Next.js (http://localhost:3000)
CORS_ORIGINS=["https://nouri.app","http://localhost:3000"]
RATE_LIMIT_CHAT_PER_HOUR=60
PLAN_GENERATION_FREE_TIER_MONTHLY_LIMIT=2
RECIPE_SIMILARITY_THRESHOLD=0.82
# Log a warning when a single Anthropic call exceeds this token total (NFR-5.3)
ANTHROPIC_TOKEN_ALERT_THRESHOLD=20000
# Per-attempt Anthropic HTTP timeout in seconds. Plan calls are also capped by the job deadline.
ANTHROPIC_HTTP_TIMEOUT_SECONDS=420
# Stop plan model calls this many seconds before the 600s job hard limit.
PLAN_JOB_DEADLINE_MARGIN_SECONDS=60
# Optional daily LLM spend ceiling in USD. Leave unset to disable the breaker.
# Prices live in config.LLM_TOKEN_PRICES_USD_PER_MILLION (empty until filled in).
# LLM_DAILY_SPEND_LIMIT_USD=
# When false, days under a calorie or protein target become review notes.
# Python does not move dishes between roles or scale servings to close the gap.
PLAN_ASSIGNER_POLISH=false
